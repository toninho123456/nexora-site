# Mesmo projeto Supabase do portal (Project Settings > API). Somente a chave ANON (pública).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço do portal interno (opcional). Se ficar vazio, o link "Portal interno" não aparece no site.
NEXT_PUBLIC_PORTAL_URL=
# WhatsApp da empresa (só números, com país e DDD). Ex.: 5581999999999. Mostra o botão "Adiantar pelo WhatsApp" depois do envio.
NEXT_PUBLIC_WHATSAPP=
# E-mail: cadastre-se em resend.com, crie uma API key e coloque o e-mail da empresa que vai receber os contatos.
RESEND_API_KEY=
CONTACT_EMAIL=
# Opcional: remetente próprio (precisa de domínio verificado no Resend). Se vazio, usa onboarding@resend.dev.
CONTACT_FROM=
